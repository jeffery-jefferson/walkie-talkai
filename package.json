{
  "name": "walkie-talkai",
  "version": "0.1.0",
  "author": "Mark Ureta",
  "description": "Voice-driven GitHub Copilot assistant with push-to-talk",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-builder",
    "build:installer": "electron-builder --win nsis",
    "publish": "electron-builder --publish always",
    "rebuild": "npx @electron/rebuild"
  },
  "dependencies": {
    "@github/copilot-sdk": ">=0.0.423",
    "chokidar": "^4.0.0",
    "decibri": "^3.0.0",
    "electron-updater": "^6.8.3",
    "sherpa-onnx-node": "latest",
    "uiohook-napi": "^1.5.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^25.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "tar": ">=7.5.13",
    "@tootallnate/once": ">=3.0.1"
  }
}
